# nginx の設定（インフラ設計書 6.2・7.3）。${ORIGIN_VERIFY} は起動時に環境変数の値へ置き換わる。
#   /api/*  → backend コンテナ（Rails、3000）へ転送する
#   それ以外 → Next.js が書き出した静的ファイルを返す

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    # CloudFront が付ける確認用ヘッダーが無い・違う要求は拒否する（他人の CloudFront から届いた要求など。6.2）
    if ($http_x_origin_verify != "${ORIGIN_VERIFY}") {
        return 403;
    }

    # backend の名前を要求のたびに Docker の DNS で引く。backend が作り直されて IP が変わっても転送できるように
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:3000;

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https; # 利用者との HTTPS は CloudFront が受け持つ（Rails は assume_ssl）
        proxy_read_timeout 30s;
    }

    # Next.js の JavaScript・CSS はファイル名に内容のハッシュが付くため、長くキャッシュしてよい
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # HTML は毎回確かめさせる（デプロイ後に古い画面が残らないように。6.1）
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
}
